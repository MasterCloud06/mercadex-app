{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mercadex-api.onrender.com",
        "EXPO_PUBLIC_ENTORNO": "produccion"
      }
    },
    "playstore": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mercadex-api.onrender.com",
        "EXPO_PUBLIC_ENTORNO": "produccion"
      }
    }
  }
}
